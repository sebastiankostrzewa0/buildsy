# Klucz API do Claude (Anthropic) — używany do parsowania zapytań w /api/parse-query.
# Bez tego klucza aplikacja nadal działa: automatycznie włącza się fallback
# oparty o dopasowanie słów kluczowych (materials.keywords).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Baza danych — PostgreSQL.
#
# Lokalnie (np. Postgres w Dockerze/lokalnie zainstalowany):
#   DATABASE_URL="postgresql://user:password@localhost:5432/buildsy"
#   DIRECT_URL="postgresql://user:password@localhost:5432/buildsy"
#
# Na Vercelu z Vercel Postgres / Neon: DATABASE_URL to connection string
# "pooled" (przez pgbouncer, zwykle kończy się `?pgbouncer=true...`),
# DIRECT_URL to connection string bezpośredni (bez poolera) — Vercel
# Postgres wystawia oba automatycznie po dodaniu bazy w zakładce Storage.
DATABASE_URL="postgresql://user:password@localhost:5432/buildsy"
DIRECT_URL="postgresql://user:password@localhost:5432/buildsy"
