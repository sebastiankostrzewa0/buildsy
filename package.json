{
  "name": "buildsy",
  "version": "1.0.0",
  "private": true,
  "description": "Buildsy — agent AI do zakupów materiałów budowlanych (MVP)",
  "scripts": {
    "dev": "npm run db:setup && next dev",
    "build": "npm run db:setup && next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:setup": "prisma generate && prisma db push --skip-generate && tsx prisma/seed.ts --if-empty"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@prisma/client": "^5.20.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
